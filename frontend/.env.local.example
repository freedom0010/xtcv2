# 区块链配置
NEXT_PUBLIC_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# IPFS 配置 (Filebase)
FILEBASE_API_KEY=your_filebase_api_key_here
FILEBASE_SECRET_KEY=your_filebase_secret_key_here
FILEBASE_BUCKET=diabetes-data-bucket
NEXT_PUBLIC_FILEBASE_GATEWAY=https://ipfs.filebase.io/ipfs/

# 应用配置
NEXT_PUBLIC_APP_NAME=糖尿病匿名统计分析平台
NEXT_PUBLIC_APP_VERSION=1.0.0

# 开发配置
NODE_ENV=development